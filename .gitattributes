* text=auto eol=lf

# Keep the distributed archive to what a consumer actually needs. config/,
# resources/ and routes/ stay in: the service provider publishes and loads them
# at runtime, so an archive without them installs a package that cannot boot.
/.github            export-ignore
/tests              export-ignore
.gitattributes      export-ignore
.gitignore          export-ignore
.editorconfig       export-ignore
.gitleaks.toml      export-ignore
phpunit.xml.dist    export-ignore
phpstan.neon.dist   export-ignore
.php-cs-fixer.dist.php export-ignore
CONTRIBUTING.md     export-ignore
CODE_OF_CONDUCT.md  export-ignore

*.php  diff=php
*.md   diff=markdown
